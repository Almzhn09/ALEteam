# Copy with npm run setup:local; generated credentials stay in ignored .env.
DATABASE_URL=postgresql://archive:CHANGE_ME@127.0.0.1:5432/archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=archive
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Provisional staff idle policy; confirm with the archive before production.
STAFF_IDLE_TIMEOUT_SECONDS=1800
DEMO_AUTHOR_PASSWORD=
DEMO_MODERATOR_PASSWORD=
FILE_STORAGE_ROOT=.local/files
# Fixtures are restricted to explicitly isolated test databases; ordinary setup imports real sources.
ALLOW_DEMO_SEED=0
ARCHIVE_CONTENT_MODE=real
# Integration tests clear data in this dedicated database; never use production.
TEST_DATABASE_URL=postgresql://archive:CHANGE_ME@127.0.0.1:5432/archive_test
# Built-in modules work without network access or model credentials.
MODERATION_MODE=local
ASSISTANT_MODE=local-model
# Optional LLM mode: ASSISTANT_MODE=llm, server-only key and explicit model.
ARCHIVE_LLM_API_KEY=
ARCHIVE_LLM_MODEL=
# Optional external overrides, never browser-supplied URLs.
MODERATION_SERVICE_URL=
MODERATION_SERVICE_TOKEN=
ASSISTANT_SERVICE_URL=
ASSISTANT_SERVICE_TOKEN=
