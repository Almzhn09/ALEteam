{
  "name": "aleteam-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build --webpack",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts tests/moderation.test.ts tests/moderation-variants.test.ts tests/assistant.test.ts tests/corpus.test.ts tests/discovery.test.ts tests/local-model.test.ts tests/site-dialog.test.ts tests/artur-full-tz.test.ts tests/artur-training-candidate.test.ts tests/artur-search-periods.test.ts tests/artur-migration.test.ts tests/artur-migration-files.test.ts tests/artur-quality-model.test.ts tests/staff-policy.test.ts tests/cms-grounding.test.ts tests/artur-content-drafts.test.ts tests/english-dialog.test.ts tests/semantic-catalog-plan.test.ts tests/assistant-quality.test.ts tests/upload-storage.test.ts tests/catalog-import-schema.test.ts tests/discovery-policy.test.ts tests/file-processing.test.ts tests/artur-discovery.test.ts tests/real-content.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/integration.test.ts",
    "db:generate": "node --import tsx scripts/generate-client.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts",
    "evaluate:artur": "node --env-file-if-exists=.env --import tsx scripts/evaluate-artur.ts",
    "demo:artur": "node --env-file-if-exists=.env --import tsx scripts/demo-artur.ts",
    "capture:artur": "node --env-file-if-exists=.env --import tsx scripts/capture-demo.ts",
    "i18n:check": "tsx scripts/i18n-keys.mjs --check",
    "scans:generate": "node --import tsx scripts/generate-demo-scans.ts",
    "test:release": "node --env-file-if-exists=.env --import tsx scripts/release-checks.ts",
    "check:llm": "node --use-env-proxy --env-file-if-exists=.env --import tsx scripts/check-live-llm.ts",
    "presentation:export": "node --import tsx scripts/export-presentation.ts",
    "deploy:setup": "node deploy/setup.mjs",
    "deploy:backup": "node deploy/backup.mjs",
    "deploy:restore": "node deploy/restore.mjs",
    "ocr:setup": "node --use-env-proxy scripts/setup-ocr.mjs",
    "evaluate:ocr": "node --import tsx scripts/evaluate-ocr.ts",
    "evaluate:search": "node --env-file-if-exists=.env --import tsx scripts/evaluate-search.ts",
    "train:local": ".local/model-env/bin/python training/train.py",
    "evaluate:local": "node --env-file-if-exists=.env --import tsx scripts/evaluate-local-model.ts",
    "evaluate:dialog": "node --env-file-if-exists=.env --import tsx scripts/evaluate-site-dialog.ts",
    "evaluate:full-tz": "node --import tsx scripts/evaluate-full-tz-model.ts",
    "audit:migration": "node --import tsx scripts/audit-artur-migration.ts",
    "staff:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-staff.ts",
    "test:cms": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/cms.integration.test.ts",
    "test:cms-assistant": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/cms-assistant.integration.test.ts",
    "content:artur:export": "node --import tsx scripts/export-artur-drafts.ts",
    "test:catalog": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/catalog.integration.test.ts",
    "test:semantic": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/semantic-catalog.integration.test.ts",
    "evaluate:semantic": "node --import tsx scripts/report-semantic-quality.ts",
    "report:quality": "node --import tsx scripts/report-assistant-quality.ts",
    "capture:review": "node --env-file-if-exists=.env --import tsx scripts/capture-review.ts",
    "test:uploads": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/uploads.integration.test.ts",
    "test:imports": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/catalog-imports.integration.test.ts",
    "test:discovery": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/discovery.integration.test.ts",
    "evaluate:discovery": "node --import tsx scripts/evaluate-artur-discovery.ts",
    "discovery:deliver": "node --env-file-if-exists=.env --import tsx scripts/deliver-topic-notices.ts",
    "uploads:inspect": "node --env-file-if-exists=.env --import tsx scripts/process-upload-inspections.ts",
    "archive:jobs": "node --env-file-if-exists=.env --import tsx scripts/watch-archive-jobs.ts",
    "check:display": "node --env-file-if-exists=.env --import tsx scripts/check-display.ts",
    "sources:verify": "node scripts/verify-archive-sources.mjs",
    "check:team-ui": "node --import tsx scripts/check-team-ui.ts",
    "check:performance": "node scripts/check-performance.mjs",
    "content:real:prepare": "python3 scripts/prepare-real-publication.py && python3 scripts/prepare-real-curation.py",
    "check:real-content": "node --env-file-if-exists=.env --import tsx scripts/check-real-content.ts"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "leaflet": "1.9.4",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@prisma/client-generator-js": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@types/leaflet": "1.9.20",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.10.2",
    "playwright-core": "1.65.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
